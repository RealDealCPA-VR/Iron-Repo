#!/bin/sh
# The iron command for macOS, Linux and Git Bash. Finds Python 3.8+ and runs Iron from this folder.
# Store "app execution alias" stubs on Windows are tried last: they are slow and often not real Pythons.
here=$(dirname "$0")
for pass in 1 2; do
  for py in python3 python py; do
    path=$(command -v "$py" 2>/dev/null) || continue
    case "$path" in
      *WindowsApps*) [ "$pass" = 1 ] && continue ;;
      *) [ "$pass" = 2 ] && continue ;;
    esac
    if "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" >/dev/null 2>&1; then
      exec "$py" "$here/iron_launch.py" cli "$@"
    fi
  done
done
echo "iron: Python 3.8 or newer is required (https://www.python.org/downloads/)" >&2
exit 1
